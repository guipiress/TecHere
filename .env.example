# Copy to .env and fill in. NEVER commit the real .env.
# Use a dedicated, least-privilege role (see database/roles.sql), not "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techere
DB_USER=techere_app
DB_PASSWORD=change-me

# Set to "production" to disable /docs, /redoc and /openapi.json.
APP_ENV=development

# JWT settings. SECRET_KEY must be random and at least 32 bytes; the app refuses
# to start otherwise. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The signing algorithm is fixed (HS256) in code and is not configurable.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
