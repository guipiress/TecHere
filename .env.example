# Copy to .env and fill in. NEVER commit the real .env.
# Use a dedicated, least-privilege role (see database/roles.sql), not "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techere
DB_USER=techere_app
DB_PASSWORD=change-me

# Set to "production" to disable /docs, /redoc and /openapi.json.
APP_ENV=development
